{
  "name": "frontend",
  "packageManager": "bun@1.4.0",
  "private": true,
  "version": "1.3.0.dev2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build-aio": "tsc -p tsconfig.build.json && vite build --emptyOutDir --outDir ../src/acere/dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "generate-client": "openapi-ts",
    "generate-frontend-paths": "bun scripts/generate_frontend_route_list.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@tanstack/react-query": "^5.102.6",
    "@tanstack/react-router": "^1.170.32",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "7.86.0",
    "react-icons": "^5.7.0",
    "shaka-player": "^5.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@hey-api/openapi-ts": "0.99.0",
    "@tanstack/react-query-devtools": "^5.102.6",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
