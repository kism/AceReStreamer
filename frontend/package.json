{
  "name": "frontend",
  "packageManager": "bun@1.4.2",
  "private": true,
  "version": "1.3.0.dev2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build-aio": "tsc -p tsconfig.build.json && vite build --emptyOutDir --outDir ../src/acere/dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome migrate --write && biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "generate-client": "openapi-ts",
    "generate-frontend-paths": "bun scripts/generate_frontend_route_list.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "7.71.1",
    "react-icons": "^5.7.0",
    "shaka-player": "^5.2.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@hey-api/openapi-ts": "0.97.3",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
